{
  "name": "canvas-fogworks",
  "version": "0.0.5",
  "description": "Visual and pixel design, 2D game authoring, and a growing 3D engine in one document-based studio.",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "jest --config=./jest.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "ci": "npm run typecheck && npm run lint && npm run doc-drift && npm run header-claims && npm run mutate:check && npm test -- --runInBand && npm run test:recovery && npm run test:progress-crash && npm run test:benchmark-budgets && npm run build && npm run smoke:startup && npm run smoke:file-workflow && npm run smoke:crash-relaunch && npm run smoke:lighting && npm run smoke:3d && npm run smoke:blockout && npm run smoke:player-blockout && npm run smoke:levels && npm run smoke:authoring && npm run smoke:player && npm run smoke:player-acceptance && npm run smoke:behavior",
    "dev": "node scripts/build.js --watch --electron",
    "dist": "node scripts/build.js && npx electron-builder",
    "smoke:startup": "node scripts/smoke-startup.js",
    "smoke:project-open": "node scripts/smoke-startup.js --project-open",
    "smoke:file-workflow": "node scripts/smoke-startup.js --project-open",
    "smoke:crash-relaunch": "node scripts/smoke-crash-relaunch.js",
    "smoke:lighting": "electron scripts/smoke-lighting.js",
    "smoke:3d": "electron scripts/smoke-3d.js",
    "smoke:blockout": "electron scripts/smoke-blockout.js",
    "smoke:player-blockout": "electron scripts/smoke-player-blockout.js",
    "smoke:levels": "electron scripts/smoke-level-transition.js",
    "smoke:player": "electron scripts/smoke-player.js",
    "smoke:player-acceptance": "electron scripts/smoke-player-acceptance.js",
    "smoke:player-startup": "node scripts/smoke-player-startup.js",
    "package:game": "node scripts/package-game.js",
    "smoke:authoring": "electron scripts/smoke-authoring.js",
    "smoke:behavior": "electron scripts/smoke-behavior.js",
    "benchmark:authoring": "node --expose-gc scripts/benchmark-authoring.js",
    "benchmark:gpu": "electron scripts/benchmark-gpu.js",
    "test:benchmark-budgets": "node --test scripts/benchmark-budgets.test.js",
    "test:recovery": "node --test scripts/crash-recovery.test.js",
    "test:progress-crash": "node --test scripts/progress-crash.test.js",
    "examples:create": "node scripts/create-reference-projects.js",
    "smoke:package": "node scripts/build.js && npx electron-builder --win nsis --publish never -c.directories.output=release && npm run check:package && node scripts/smoke-startup.js --packaged \"release/win-unpacked/Canvas Fogworks.exe\" && node scripts/smoke-startup.js --project-open --packaged \"release/win-unpacked/Canvas Fogworks.exe\"",
    "check:package": "node scripts/check-package.js",
    "test:package": "node --test scripts/check-package.test.js scripts/smoke-profile.test.js scripts/installer-lifecycle.test.js scripts/player-exe-evidence.test.js scripts/package-signature.test.js scripts/world-partition-claim.test.js",
    "validate:hardware-gpu": "electron scripts/validate-hardware-gpu.js",
    "build:installer-test-baseline": "electron-builder --win nsis --publish never --config.directories.output=release/installer-test-baseline --config.extraMetadata.version=0.0.4 --config.artifactName=TEST-ONLY-baseline-0.0.4.exe",
    "prepare:installer-sandbox": "node scripts/prepare-installer-sandbox.js",
    "check:installer-evidence": "node scripts/check-installer-evidence.js",
    "check:player-exe-evidence": "node scripts/check-player-exe-evidence.js",
    "check:package-signature": "node scripts/check-package-signature.js",
    "check:world-partition": "node scripts/check-world-partition.js",
    "lint": "node scripts/check-module-headers.js",
    "doc-drift": "node scripts/check-doc-drift.js",
    "mutate:dimensions": "node scripts/mutate-dimensions.js",
    "mutate:check": "node scripts/mutate-dimensions.js --check",
    "header-claims": "node scripts/check-header-claims.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.4.0"
  },
  "build": {
    "appId": "com.canvasfogworks.app",
    "productName": "Canvas Fogworks",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/electron/**/*",
      "dist/app/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
