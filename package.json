{
  "name": "canvas-fogworks",
  "version": "0.0.5",
  "description": "A document-based visual programming engine for interfaces.",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "jest --config=./jest.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "ci": "npm run typecheck && npm run lint && npm run doc-drift && npm run header-claims && npm test -- --runInBand && npm run build && npm run smoke:startup && npm run smoke:file-workflow && npm run smoke:lighting && npm run smoke:3d",
    "dev": "node scripts/build.js --watch --electron",
    "dist": "node scripts/build.js && npx electron-builder",
    "smoke:startup": "node scripts/smoke-startup.js",
    "smoke:project-open": "node scripts/smoke-startup.js --project-open",
    "smoke:file-workflow": "node scripts/smoke-startup.js --project-open",
    "smoke:lighting": "electron scripts/smoke-lighting.js",
    "smoke:3d": "electron scripts/smoke-3d.js",
    "smoke:package": "node scripts/build.js && npx electron-builder --win nsis --publish never -c.directories.output=release && node scripts/smoke-startup.js --packaged \"release/win-unpacked/Canvas Fogworks.exe\" && node scripts/smoke-startup.js --project-open --packaged \"release/win-unpacked/Canvas Fogworks.exe\"",
    "lint": "node scripts/check-module-headers.js",
    "doc-drift": "node scripts/check-doc-drift.js",
    "mutate:dimensions": "node scripts/mutate-dimensions.js",
    "header-claims": "node scripts/check-header-claims.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.4.0"
  },
  "build": {
    "appId": "com.canvasfogworks.app",
    "productName": "Canvas Fogworks",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/electron/**/*",
      "dist/app/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
